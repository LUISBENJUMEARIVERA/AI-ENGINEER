# AETHER Engine — Production & Local Environment Configuration
AETHER_ENV=production
AETHER_LOG_LEVEL=INFO

# Persistence & State (Redis L1 Ring Buffer + PostgreSQL 16 pgvector ACID Event Store)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://aether:aether_secret@localhost:5432/aether_engine

# Smart Gateway Model Provider API Keys (LiteLLM / Native Adapters)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VLLM_ENDPOINT_URL=http://localhost:8080/v1

# Circuit Breaker & SLA Enforcement
AETHER_SLA_MAX_LATENCY_MS=4500
AETHER_CB_FAILURE_THRESHOLD=3
AETHER_CB_RECOVERY_TIMEOUT_SEC=15.0

# OpenTelemetry Distributed Tracing (Jaeger / Langfuse OTLP)
OTEL_SERVICE_NAME=aether-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
